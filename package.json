{
	"name": "@imranbarbhuiya/oxc-config",
	"version": "0.4.1",
	"description": "Shared Oxlint and Oxfmt configs for JavaScript and TypeScript projects",
	"keywords": [
		"config",
		"format",
		"formatter",
		"lint",
		"linter",
		"oxc",
		"oxfmt",
		"oxlint",
		"typescript"
	],
	"homepage": "https://github.com/imranbarbhuiya/oxc-config#readme",
	"bugs": {
		"url": "https://github.com/imranbarbhuiya/oxc-config/issues"
	},
	"license": "MIT",
	"author": "Parbez <imranbarbhuiya.fsd@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imranbarbhuiya/oxc-config.git"
	},
	"bin": {
		"oxc-config": "dist/cli/index.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"typesVersions": {
		"*": {
			"api-error": [
				"./dist/api-error.d.ts"
			],
			"central-icons": [
				"./dist/central-icons.d.ts"
			],
			"common": [
				"./dist/common.d.ts"
			],
			"edge": [
				"./dist/edge.d.ts"
			],
			"effect": [
				"./dist/effect.d.ts"
			],
			"effect-types-only": [
				"./dist/effect-types-only.d.ts"
			],
			"i18n": [
				"./dist/i18n.d.ts"
			],
			"jsdoc": [
				"./dist/jsdoc.d.ts"
			],
			"module": [
				"./dist/module.d.ts"
			],
			"native": [
				"./dist/native.d.ts"
			],
			"native-tailwind": [
				"./dist/native-tailwind.d.ts"
			],
			"nest": [
				"./dist/nest.d.ts"
			],
			"next": [
				"./dist/next.d.ts"
			],
			"node": [
				"./dist/node.d.ts"
			],
			"react": [
				"./dist/react.d.ts"
			],
			"tsdoc": [
				"./dist/tsdoc.d.ts"
			],
			"typescript": [
				"./dist/typescript.d.ts"
			],
			"unistyles": [
				"./dist/unistyles.d.ts"
			],
			"tailwind": [
				"./dist/tailwind.d.ts"
			],
			"oxfmt": [
				"./dist/oxfmt.d.ts"
			]
		}
	},
	"exports": {
		"./api-error": {
			"types": "./dist/api-error.d.ts",
			"import": "./dist/api-error.js",
			"default": "./dist/api-error.js"
		},
		"./central-icons": {
			"types": "./dist/central-icons.d.ts",
			"import": "./dist/central-icons.js",
			"default": "./dist/central-icons.js"
		},
		"./common": {
			"types": "./dist/common.d.ts",
			"import": "./dist/common.js",
			"default": "./dist/common.js"
		},
		"./edge": {
			"types": "./dist/edge.d.ts",
			"import": "./dist/edge.js",
			"default": "./dist/edge.js"
		},
		"./effect": {
			"types": "./dist/effect.d.ts",
			"import": "./dist/effect.js",
			"default": "./dist/effect.js"
		},
		"./effect-types-only": {
			"types": "./dist/effect-types-only.d.ts",
			"import": "./dist/effect-types-only.js",
			"default": "./dist/effect-types-only.js"
		},
		"./i18n": {
			"types": "./dist/i18n.d.ts",
			"import": "./dist/i18n.js",
			"default": "./dist/i18n.js"
		},
		"./jsdoc": {
			"types": "./dist/jsdoc.d.ts",
			"import": "./dist/jsdoc.js",
			"default": "./dist/jsdoc.js"
		},
		"./module": {
			"types": "./dist/module.d.ts",
			"import": "./dist/module.js",
			"default": "./dist/module.js"
		},
		"./native": {
			"types": "./dist/native.d.ts",
			"import": "./dist/native.js",
			"default": "./dist/native.js"
		},
		"./native-tailwind": {
			"types": "./dist/native-tailwind.d.ts",
			"import": "./dist/native-tailwind.js",
			"default": "./dist/native-tailwind.js"
		},
		"./nest": {
			"types": "./dist/nest.d.ts",
			"import": "./dist/nest.js",
			"default": "./dist/nest.js"
		},
		"./next": {
			"types": "./dist/next.d.ts",
			"import": "./dist/next.js",
			"default": "./dist/next.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js",
			"default": "./dist/node.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js",
			"default": "./dist/react.js"
		},
		"./tsdoc": {
			"types": "./dist/tsdoc.d.ts",
			"import": "./dist/tsdoc.js",
			"default": "./dist/tsdoc.js"
		},
		"./typescript": {
			"types": "./dist/typescript.d.ts",
			"import": "./dist/typescript.js",
			"default": "./dist/typescript.js"
		},
		"./unistyles": {
			"types": "./dist/unistyles.d.ts",
			"import": "./dist/unistyles.js",
			"default": "./dist/unistyles.js"
		},
		"./tailwind": {
			"types": "./dist/tailwind.d.ts",
			"import": "./dist/tailwind.js",
			"default": "./dist/tailwind.js"
		},
		"./oxfmt": {
			"types": "./dist/oxfmt.d.ts",
			"import": "./dist/oxfmt.js",
			"default": "./dist/oxfmt.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "oxlint --fix .",
		"lint:check": "oxlint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"build": "tsdown",
		"test": "bun run build && bun test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@oxlint/plugins": "1.89.0",
		"eslint": "^10.13.0",
		"eslint-plugin-jsdoc": "^65.4.2",
		"eslint-plugin-n": "^18.5.0",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-tsdoc": "^0.5.4",
		"nypm": "^0.6.11",
		"oxlint-tailwindcss": "^1.16.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@typescript-eslint/utils": "^8.72.0",
		"effect": "^4.0.6",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"tsdown": "^0.23.2",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"effect": "^4.0.6",
		"oxfmt": ">=0.74.0 <0.76.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005"
	},
	"peerDependenciesMeta": {
		"effect": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"overrides": {
		"zod": "^4",
		"zod-validation-error": "^4"
	},
	"engines": {
		"node": ">=22.22.2"
	}
}
