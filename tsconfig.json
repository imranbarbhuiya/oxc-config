{
	"compilerOptions": {
		"types": ["bun"],
		"target": "esnext",
		"module": "preserve",
		"strict": true,
		"allowJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noImplicitThis": true,
		"alwaysStrict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"moduleResolution": "bundler",
		"lib": ["es2023"],
		"outDir": "dist",
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "oxlint.config.ts", "oxfmt.config.ts"],
	"exclude": ["tests/fixtures"]
}
